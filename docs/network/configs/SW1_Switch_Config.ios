! ==================================================================
! CISCO SWITCH CONFIGURATION : SW1-DISTRIB (Catalyst 2960-24TT)
! PROJET : InduTwin - Distributed Industrial Digital Twin (Phase 6)
! RÔLE   : Segmentation VLANs, Trunk 802.1Q, IGMP Snooping & Querier
! ==================================================================

version 15.0
no service password-encryption
!
hostname SW1-DISTRIB
!
! --- ACTIVATION DES VLANS ---
vlan 10
 name INDUSTRIAL_PLANT
!
vlan 20
 name SCADA_SUPERVISION
!
! --- IGMP SNOOPING & QUERIER ---
ip igmp snooping
ip igmp snooping vlan 10
ip igmp snooping vlan 20
ip igmp snooping querier
ip igmp snooping vlan 10 immediate-leave
ip igmp snooping vlan 20 immediate-leave
!
! --- PORTS ATELIER (MACHINES M01, M02, M03) ---
interface range FastEthernet0/1 - 3
 description Hotes Industriels M01-M02-M03
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
!
! --- PORTS SUPERVISION (SCADA & RMI) ---
interface range FastEthernet0/10 - 12
 description Postes Supervision SCADA et RMI
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
!
! --- PORT TRUNK VERS ROUTEUR R1 ---
interface GigabitEthernet0/1
 description Trunk 802.1Q vers R1 Gi0/0
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
!
! --- INTERFACE D'ADMINISTRATION SWITCH (SVI) ---
interface vlan 20
 description Interface Management Switch
 ip address 192.168.20.2 255.255.255.0
 no shutdown
!
ip default-gateway 192.168.20.1
!
line con 0
 logging synchronous
line vty 0 4
 login
!
end
